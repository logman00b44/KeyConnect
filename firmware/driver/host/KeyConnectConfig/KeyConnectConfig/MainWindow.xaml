<Window
    x:Class="KeyConnectConfig.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KeyConnect R1 Configurator v2.00"
    SizeChanged="OnSizeChanged">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClick"/>
            <Button x:Name="DisconnectButton" Content="Disconnect" Click="OnDisconnectClick" IsEnabled="False"/>
            <TextBlock x:Name="DeviceStatus" Text="Disconnected" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Row 1: Layer selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Layer:" VerticalAlignment="Center"/>
            <ComboBox x:Name="LayerCombo" SelectedIndex="0" IsEnabled="False" MinWidth="80"/>
            <Button x:Name="ReadAllButton" Content="Read All from Device" Click="OnReadAllClick" IsEnabled="False"/>
            <Button x:Name="SaveButton" Content="Save to Flash" Click="OnSaveClick" IsEnabled="False"/>
        </StackPanel>

        <!-- Row 2: Layer indicator / mode info -->
        <TextBlock Grid.Row="2" x:Name="InfoText" Text="Click a key cell to edit its mapping" Margin="0,0,0,4" Opacity="0.6"/>

        <!-- Row 3: 4x4 Key Grid -->
        <Border Grid.Row="3" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="4">
            <Grid x:Name="KeyGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Border>

        <!-- Row 4: Status bar -->
        <TextBlock Grid.Row="4" x:Name="StatusText" Text="Ready" Margin="0,8,0,0" Opacity="0.5"/>
    </Grid>
</Window>
