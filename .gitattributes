# Auto detect text files and perform LF normalization
* text=auto

# Explicit binary types (never normalise / diff these)
*.pcbdoc  binary
*.schdoc  binary
*.obj     binary
*.step    binary
*.stp     binary
*.dwg     binary
*.dxf     binary
*.bin     binary
*.elf     binary
*.map     -text
*.exe     binary
*.dll     binary
*.png     binary
*.svg     -text

# Interactive HTML BOM viewer: keep byte-exact, never normalise line endings
*.html    -text
